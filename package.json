{
  "name": "smart-lunch-delivery-backend",
  "version": "1.0.0",
  "description": "Backend API for Smart Lunch Delivery Route Optimization & Rider Task Allocation",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "prisma generate && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js",
    "start": "prisma db push && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.24.2",
    "express": "^4.21.1",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
